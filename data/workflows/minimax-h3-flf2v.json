    "video_megapixels_key": "megapixels",
    "video_duration_node": "105:111",
    "video_duration_key": "value",
    "default_model": "minimax_h3_fl2va_pruned_int8_convrot.safetensors",
    "workflow_file": "video_minimax_h3_flf2v.json"
