# Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE

# 代理设置 (Telegram API 需要代理访问)
# 常见格式: socks5://127.0.0.1:10808 或 http://127.0.0.1:10808
PROXY_URL=socks5://127.0.0.1:10808

# DeepSeek API Key (翻译用, OpenAI 兼容接口)
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE

# SD WebUI API 地址 (可选，默认如下)
# SD_API_BASE=http://10.126.126.1:7860

# DeepSeek API 地址 (可选，默认如下)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama 本地大模型 (图片反推/Prompt 助手，可选，默认如下)
# OLLAMA_BASE_URL=http://10.126.126.4:11434
# OLLAMA_MODEL=huihui_ai/Qwen3.8-abliterated:latest
# OLLAMA_TIMEOUT=900
# qwen3 系关闭思考会拒绝 NSFW 输出，默认开启
# OLLAMA_THINK=true

# Web 管理面板认证 (FastAPI)
ADMIN_PASSWORD=change_me
ADMIN_SECRET_KEY=change_me_to_random_string

# 访问控制 (可选，逗号分隔；留空 = 不限制)
# ALLOWED_USER_IDS=123456789,987654321
# ALLOWED_CHAT_IDS=-1001234567890
# ADMIN_USER_ID=7562421953
