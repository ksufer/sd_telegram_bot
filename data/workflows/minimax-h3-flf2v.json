    "is_img2img": true,
    "use_caption_as_prompt": true,
    "model_selectable": false,
    "output_type": "video",
    "prompt_node": "105:104",
    "prompt_key": "prompt",
    "seed_node": "105:15",
    "seed_key": "noise_seed",
